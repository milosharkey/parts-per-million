# Every enzyme on Wikidata: items with an EC (Enzyme Commission) number and
# an English Wikipedia article.
#
# Paste this into https://query.wikidata.org and press the play button to
# explore the results yourself.
#
# Why these choices:
# - P591 is the EC number, the international classification of enzymes by
#   the reaction they catalyse ("EC 3.2.1.1" is alpha-amylase). Having one is
#   a clean definition of "an enzyme" that needs no class hierarchy.
# - Enzyme families with no single EC number (DNA polymerase, protease) are
#   added by hand in data/enzymes/extras.csv.
# - Columns match minerals.rq, so the rest of the pipeline doesn't change.
SELECT ?item ?label ?title ?sitelinks
       (GROUP_CONCAT(DISTINCT ?alias; separator="|") AS ?aliases)
WHERE {
  ?item wdt:P591 ?ec ;
        wikibase:sitelinks ?sitelinks ;
        rdfs:label ?label .
  FILTER(LANG(?label) = "en")

  ?article schema:about ?item ;
           schema:isPartOf <https://en.wikipedia.org/> ;
           schema:name ?title .

  OPTIONAL {
    ?item skos:altLabel ?alias .
    FILTER(LANG(?alias) = "en")
  }
}
GROUP BY ?item ?label ?title ?sitelinks
